{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "「", "close": "」" }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*[-*+]\\s+\\S.*$",
      "action": { "indent": "none", "appendText": "- " }
    }
  ]
}
